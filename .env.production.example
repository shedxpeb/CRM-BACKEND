# =============================================================================
# ADMIN-CRM BACKEND — PRODUCTION ENVIRONMENT
# =============================================================================
# Copy this file to .env.production and fill in ONLY the values marked 🔧
# Everything else auto-derives or has safe defaults.
# =============================================================================

# ── 🔧 REQUIRED: Change these for every deployment ───────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/peb-crm?sslmode=require&connection_limit=20&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/peb-crm?sslmode=require&connection_limit=20&pool_timeout=10"

# Secrets (generate with: openssl rand -base64 48)
JWT_SECRET=
COOKIE_SECRET=

# Your frontend domain (used for CORS + cookie domain)
FRONTEND_URL=https://buildxcrm.com

# SMTP Email (for OTP, password reset, notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@buildxcrm.com
SMTP_FROM_NAME=PEB CRM

# ── OPTIONAL: Only change if needed ──────────────────────────────────────────

# Server port (must match CloudPanel reverse proxy target)
PORT=3003

# Additional CORS origins (comma-separated, FRONTEND_URL is always included)
# ALLOWED_ORIGINS=https://admin.buildxcrm.com

# Rate limits (defaults are production-ready, tune after load testing)
THROTTLE_LIMIT=300
THROTTLE_AUTH_LIMIT=30
THROTTLE_PDF_LIMIT=30
THROTTLE_BULK_LIMIT=50
THROTTLE_PASSWORD_RESET_LIMIT=20

# Node environment
NODE_ENV=production
