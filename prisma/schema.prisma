// ============================================================================
// BUSINESS MODELS
// ============================================================================

model Customer {
  id                  String         @id @default(uuid())
  organizationId      String
  customerId          Int            @default(autoincrement())
  customerName        String
  companyName         String
  mobile              String
  alternateMobile     String?
  email               String
  gstNumber           String?
  panNumber           String?
  industry            Industry?
  businessType        BusinessType?
  website             String?
  address             String
  city                String
  state               String
  country             String         @default("India")
  pincode             String?
  assignedEmployee    String?
  assignedEmployeeId  String?
  source              String         @default("Website")
  status              CustomerStatus @default(Prospect)
  notes               String?
  attachments         String[]
  customerSince       DateTime       @default(now())
  leadId              String?
  convertedFromLeadId String?
  projectTitle        String?
  projectType         String?
  createdById         String?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  isDeleted           Boolean        @default(false)
  deletedAt           DateTime?
  deletedById         String?
  customFields        Json?
  organization        Organization   @relation(fields: [organizationId], references: [id])
  projects            Project[]

  @@unique([organizationId, customerId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  @@index([mobile])
  @@index([companyName])
  @@index([isDeleted])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Lead {
  id                  String              @id @default(uuid())
  organizationId      String
  leadNumber          Int                 @default(autoincrement())
  customerName        String
  companyName         String
  designation         String?
  website             String?
  mobile              String
  alternateMobile     String?
  email               String
  gstNumber           String?
  panNumber           String?
  industry            Industry?
  businessType        BusinessType?
  addressLine1        String?
  addressLine2        String?
  area                String?
  city                String?
  state               String?
  country             String              @default("India")
  pincode             String?
  companySize         String?
  annualRevenue       Float?
  employeeCount       Int?
  linkedin            String?
  facebook            String?
  instagram           String?
  profileImage        String?
  companyLogo         String?
  tags                String[]
  projectTitle        String
  projectType         ProjectType
  structureType       StructureType
  width               Float?
  length              Float?
  height              Float?
  baySpacing          Float?
  roofType            RoofType?
  craneRequired       Boolean             @default(false)
  craneCapacity       Float?
  mezzanine           Boolean             @default(false)
  mezzanineArea       Float?
  mezzanineLoad       Float?
  wallType            WallType?
  insulationRequired  Boolean             @default(false)
  insulationType      String?
  insulationThickness Float?
  materialPreference  MaterialPreference?
  siteLocation        String?
  siteAddress         String?
  mapCoordinates      String?
  soilNotes           String?
  customerNotes       String?
  specialRequirement  String?
  attachments         String[]
  source              LeadSource
  priority            LeadPriority
  status              LeadStatus          @default(New)
  createdById         String
  assignedToId        String?
  assignedTo          String?
  remarks             String?
  score               Int?
  isConverted         Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastFollowUp        DateTime?
  nextFollowUpDate    DateTime?
  createdBy           String?
  updatedBy           String?
  customerId          String?
  convertedDate       DateTime?
  isDeleted           Boolean             @default(false)
  deletedAt           DateTime?
  deletedById         String?
  customFields        Json?
  currentDate         String?
  organization        Organization        @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, leadNumber])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([nextFollowUpDate])
  @@index([mobile])
  @@index([companyName])
  @@index([createdById])
  @@index([assignedToId])
  @@index([isDeleted])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Project {
  id                      String              @id @default(uuid())
  organizationId          String
  projectId               Int                 @default(autoincrement())
  projectCode             String?
  projectName             String
  customerId              String
  customerName            String?
  leadId                  String?
  projectType             String
  value                   Float?
  budget                  Float?
  location                String
  city                    String
  state                   String
  pincode                 String?
  startDate               DateTime?
  endDate                 DateTime?
  priority                ProjectPriority
  projectManager          String?
  projectManagerId        String
  structureType           String
  width                   Float?
  length                  Float?
  height                  Float?
  baySpacing              Float?
  roofType                String
  craneSystem             String
  mezzanine               Boolean             @default(false)
  wallType                String
  insulation              Boolean             @default(false)
  coveredArea             Float?
  totalWeight             Float?
  status                  String              @default("Lead")
  stage                   ProjectStage?
  progress                Int                 @default(0)
  designProgress          Int                 @default(0)
  procurementProgress     Int                 @default(0)
  fabricationProgress     Int                 @default(0)
  installationProgress    Int                 @default(0)
  healthStatus            String              @default("Healthy")
  timelineHealth          String              @default("Healthy")
  budgetHealth            String              @default("Healthy")
  materialHealth          String              @default("Healthy")
  resourceHealth          String              @default("Healthy")
  materialCost            Float?
  procurementCost         Float?
  fabricationCost         Float?
  installationCost        Float?
  profitMargin            Float?
  boqId                   String?
  designId                String?
  estimateId              String?
  proposalId              String?
  quotationId             String?
  invoiceIds              String[]
  inventoryReservationIds String[]
  reservedItems           String[]
  consumedItems           String[]
  customFields            Json?
  createdById             String?
  createdBy               String?
  updatedBy               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  isDeleted               Boolean             @default(false)
  deletedAt               DateTime?
  deletedById             String?
  organization            Organization        @relation(fields: [organizationId], references: [id])
  customer                Customer?           @relation(fields: [customerId], references: [id])
  milestones              ProjectMilestone[]
  teamMembers             ProjectTeamMember[]
  activities              ProjectActivity[]
  tasks                   ProjectTask[]

  @@unique([organizationId, projectId])
  @@index([status])
  @@index([stage])
  @@index([priority])
  @@index([createdAt])
  @@index([customerId])
  @@index([customerName])
  @@index([projectManagerId])
  @@index([isDeleted])
  @@index([projectCode])
  @@index([organizationId])
  @@index([organizationId, status])
}

model ProjectMilestone {
  id          String                 @id @default(uuid())
  projectId   String
  name        String
  plannedDate DateTime?
  actualDate  DateTime?
  status      ProjectMilestoneStatus @default(Pending)
  delay       Int?
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTeamMember {
  id           String   @id @default(uuid())
  projectId    String
  employeeId   String
  name         String?
  role         String
  assignedDate DateTime @default(now())
  workload     Int?
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([employeeId])
}

model ProjectActivity {
  id          String              @id @default(uuid())
  projectId   String
  type        ProjectActivityType
  description String
  performedBy String?
  performedAt DateTime            @default(now())
  metadata    Json?
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, performedAt])
}

model ProjectTask {
  id             String            @id @default(uuid())
  projectId      String
  title          String
  description    String?
  assignedTo     String
  assignedToName String?
  dueDate        DateTime?
  priority       ProjectPriority
  status         ProjectTaskStatus @default(Pending)
  dependencies   String[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, status])
  @@index([assignedTo])
}

model Task {
  id                String            @id @default(uuid())
  title             String
  description       String?
  status            TaskStatus        @default(Pending)
  priority          TaskPriority      @default(Medium)
  category          TaskCategory      @default(General)
  dueDate           DateTime?
  assignedTo        String?
  assignedUserId    String?
  assignedUserName  String?
  createdById       String?
  createdByName     String?
  projectId         String?
  taskId            String?
  leadId            String?
  customerId        String?
  documentId        String?
  startDate         DateTime?
  reminderDate      DateTime?
  progress          Int?
  estimatedHours    Float?
  timeSpent         Float?
  completedAt       DateTime?
  verifiedAt        DateTime?
  verifiedBy        String?
  verifiedByName    String?
  verificationNotes String?
  completionNotes   String?
  completionProof   Json?
  afterImages       String[]
  beforeImages      String[]
  incentiveValue    Float             @default(0)
  tags              String[]
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  deletedById       String?
  organizationId    String?
  checklists        TaskChecklist[]
  comments          TaskComment[]
  attachments       TaskAttachment[]
  dependencies      TaskDependency[]  @relation("TaskDependencies")
  dependsOn         TaskDependency[]  @relation("DependentTasks")
  activityLogs      TaskActivityLog[]
  organization      Organization?     @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedTo])
  @@index([organizationId])
  @@index([projectId])
  @@index([isDeleted])
}

model TaskChecklist {
  id          String    @id @default(uuid())
  taskId      String
  text        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  completedBy String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id         String   @id @default(uuid())
  taskId     String
  content    String
  authorId   String
  authorName String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model TaskAttachment {
  id             String   @id @default(uuid())
  taskId         String
  fileName       String
  fileType       String
  fileSize       Int
  fileUrl        String
  uploadedBy     String
  uploadedByName String
  description    String?
  createdAt      DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  relationship    String   @default("Depends On")
  createdAt       DateTime @default(now())
  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       Task     @relation("DependentTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskActivityLog {
  id              String   @id @default(uuid())
  taskId          String
  activityType    String
  description     String
  performedBy     String
  performedByName String
  metadata        Json?
  createdAt       DateTime @default(now())
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model SalaryAdjustment {
  id             String                 @id @default(uuid())
  organizationId String
  employeeId     String
  employeeName   String
  type           SalaryAdjustmentType
  amount         Float
  description    String
  reason         String?
  referenceType  String?
  referenceId    String?
  referenceName  String?
  status         SalaryAdjustmentStatus @default(Pending)
  approvedBy     String?
  approvedByName String?
  approvedAt     DateTime?
  processedAt    DateTime?
  processedBy    String?
  notes          String?
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  isDeleted      Boolean                @default(false)
  organization   Organization           @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([employeeId])
  @@index([isDeleted])
}

