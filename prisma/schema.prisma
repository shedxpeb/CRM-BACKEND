generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String               @id @default(uuid())
  name                 String
  email                String?              @unique
  mobile               String?
  address              String?
  city                 String?
  state                String?
  country              String?              @default("India")
  pincode              String?
  gstNumber            String?
  panNumber            String?
  website              String?
  status               OrganizationStatus   @default(Active)
  maxUsers             Int                  @default(25)
  maxStorageGb         Int                  @default(10)
  subscriptionTier     String               @default("free")
  settings             Json?
  createdById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  isDeleted            Boolean              @default(false)
  deletedAt            DateTime?
  code                 String?              @unique
  deletedById          String?
  slug                 String?              @unique
  version              Int                  @default(1)
  maxRoleDepth         Int                  @default(5)
  permissionPool       Json?
  roleHierarchyEnabled Boolean              @default(true)
  customers            Customer[]
  inventoryCategories  InventoryCategory[]
  inventoryItems       InventoryItem[]
  itemBundles          ItemBundle[]
  itemMasters          ItemMaster[]
  itemVariants         ItemVariant[]
  leads                Lead[]              @relation("OrganizationLeads")
  modules              OrganizationModule[]
  projects             Project[]
  purchaseOrders       PurchaseOrder[]
  roles                Role[]
  salaryAdjustments    SalaryAdjustment[]
  stockMovements       StockMovement[]
  suppliers            Supplier[]
  tasks                Task[]
  users                User[]
  userRoles            UserRoleAssignment[]
  vendors              Vendor[]
  warehouses           Warehouse[]

  @@index([status])
  @@index([email])
  @@index([name])
  @@index([slug])
  @@index([code])
  @@index([isDeleted])
  @@index([createdAt])
}

model User {
  id                        String           @id @default(uuid())
  email                     String           @unique
  password                  String
  isActive                  Boolean          @default(false)
  isVerified                Boolean          @default(false)
  mustChangePassword        Boolean          @default(false)
  otp                       String?
  otpExpiry                 DateTime?
  otpAttempts               Int              @default(0)
  organizationType          OrganizationType @default(COMPANY)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  avatar                    String?
  department                String?
  designation               String?
  failedLoginAttempts       Int              @default(0)
  isLocked                  Boolean          @default(false)
  lastLogin                 DateTime?
  lockedUntil               DateTime?
  mobile                    String?
  name                      String?
  organizationId            String?
  passwordHistory           Json?
  passwordVersion           Int              @default(1)
  deletedAt                 DateTime?
  deletedById               String?
  isDeleted                 Boolean          @default(false)
  version                   Int              @default(1)
  role                      CrmUserRole      @default(EMPLOYEE)
  effectivePermissions      Json?
  lastPermissionCalculation DateTime?
  permissionVersion         Int              @default(1)
  createdEntities           AuditLog[]       @relation("CreatedEntities")
  refreshTokens             RefreshToken[]
  sessions                  Session[]
  organization              Organization?    @relation(fields: [organizationId], references: [id])
  userRoles                 UserRoleAssignment[]
  userPermissions           UserPermission[]
  userModuleAccess          UserModuleAccess[]

  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@index([organizationId, role])
  @@index([isDeleted])
  @@index([isActive])
}

model Session {
  id             String         @id @default(uuid())
  userId         String
  organizationId String?
  token          String         @unique
  refreshToken   String?
  device         String?
  browser        String?
  os             String?
  ipAddress      String?
  userAgent      String?
  loginAt        DateTime       @default(now())
  lastActivity   DateTime       @default(now())
  expiresAt      DateTime
  idleExpiresAt  DateTime
  isRevoked      Boolean        @default(false)
  revokedAt      DateTime?
  isRememberMe   Boolean        @default(false)
  refreshTokens  RefreshToken[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@index([organizationId])
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  sessionId           String
  userId              String
  organizationId      String?
  expiresAt           DateTime
  isRevoked           Boolean   @default(false)
  revokedAt           DateTime?
  replacedByTokenHash String?
  session             Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([sessionId])
  @@index([userId])
  @@index([organizationId])
}

model LoginAttempt {
  id             String    @id @default(uuid())
  email          String
  organizationId String?
  ipAddress      String?
  userAgent      String?
  success        Boolean
  failureReason  String?
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([email, createdAt])
  @@index([organizationId])
}

/// Hashed OTP challenges only — never plaintext OTP, never email HTML/text/subject.
/// Rows are hard-deleted immediately after successful verification, expiry, or invalidation.
model OtpChallenge {
  id          String     @id @default(uuid())
  email       String
  userId      String?
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int
  resendCount Int        @default(0)
  maxResends  Int
  /// Legacy soft-consume marker; runtime prefers hard-delete after use/expiry.
  consumedAt  DateTime?
  lastSentAt  DateTime   @default(now())
  /// Operational metadata only — never OTP, HTML, subject, or secrets.
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([email, purpose, consumedAt])
  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  sessionId      String?
  action         String
  resource       String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  after          Json?
  before         Json?
  correlationId  String?
  requestId      String?
  resourceCode   String?
  severity       AuditSeverity @default(INFO)
  createdBy      User?         @relation("CreatedEntities", fields: [userId], references: [id], map: "AuditLog_createdBy_fkey")

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@index([severity])
  @@index([correlationId])
  @@index([organizationId, createdAt])
}

model Role {
  id              String           @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  permissions     String[]
  isSystem        Boolean          @default(false)
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  code            String?
  deletedAt       DateTime?
  deletedById     String?
  isDeleted       Boolean          @default(false)
  version         Int              @default(1)
  inheritsFromId  String?
  level           Int              @default(0)
  permissionIds   String[]
  inheritsFrom    Role?            @relation("RoleHierarchy", fields: [inheritsFromId], references: [id])
  inheritedRoles  Role[]           @relation("RoleHierarchy")
  organization    Organization     @relation(fields: [organizationId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isDeleted])
  @@index([inheritsFromId])
}

model Permission {
  id              String           @id @default(uuid())
  organizationId  String?
  key             String
  module          String
  label           String
  description     String?
  category        String           @default("general")
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  action          String
  rolePermissions RolePermission[]

  @@unique([organizationId, key])
  @@index([module])
  @@index([organizationId])
  @@index([action])
}

model UserRoleAssignment {
  id             String       @id @default(uuid())
  userId         String
  roleId         String
  organizationId String
  assignedById   String?
  assignedAt     DateTime     @default(now())
  org            Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])

  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  grantedById  String?
  grantedAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// User-level permission override: grants additional permissions the role does
// not provide (granted=true) or denies permissions the role would otherwise
// allow (granted=false). Effective = role perms + granted - denied.
model UserPermission {
  id             String       @id @default(uuid())
  userId         String
  permissionKey  String
  granted        Boolean      @default(true)
  organizationId String
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey, organizationId])
  @@index([userId])
  @@index([permissionKey])
  @@index([organizationId])
}

// User-level module access override: narrows or widens the modules this user
// can use relative to the organization defaults. No rows = inherit org
// modules. Rows with allowed=true/false are explicit overrides.
model UserModuleAccess {
  id             String   @id @default(uuid())
  userId         String
  moduleKey      String
  allowed        Boolean  @default(true)
  organizationId String
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey, organizationId])
  @@index([userId])
  @@index([moduleKey])
  @@index([organizationId])
}

model PermissionDelegation {
  id             String    @id @default(uuid())
  organizationId String
  delegatedBy    String
  delegatedTo    String
  permissionId   String
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedBy      String?
  reason         String?

  @@index([organizationId])
  @@index([delegatedBy])
  @@index([delegatedTo])
  @@index([permissionId])
}

model OrganizationModule {
  id             String       @id @default(uuid())
  organizationId String
  moduleKey      String
  enabled        Boolean      @default(true)
  configuredById String?
  enabledAt      DateTime?
  disabledAt     DateTime?
  settings       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  grantedBy      String?
  permissionSet  Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleKey])
  @@index([organizationId])
  @@index([moduleKey])
}

model SystemSettings {
  id        String      @id @default(uuid())
  key       String      @unique
  value     Json
  type      SettingType @default(STRING)
  category  String      @default("general")
  isSecret  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([category])
}

model Customer {
  id                  String         @id @default(uuid())
  organizationId      String
  customerId          Int            @default(autoincrement())
  customerName        String
  companyName         String
  mobile              String
  alternateMobile     String?
  email               String
  gstNumber           String?
  panNumber           String?
  industry            Industry?
  website             String?
  address             String
  city                String
  state               String
  country             String         @default("India")
  pincode             String?
  assignedEmployee    String?
  assignedEmployeeId  String?
  source              String         @default("Website")
  status              CustomerStatus @default(Active)
  notes               String?
  attachments         String[]
  customerSince       DateTime       @default(now())
  leadId              String?
  convertedFromLeadId String?
  createdById         String?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  isDeleted           Boolean        @default(false)
  deletedAt           DateTime?
  deletedById         String?
  customFields        Json?
  businessType        BusinessType?
  projectTitle        String
  projectType         String?
  projectCode         String?
  accountTier         String?
  creditLimit         Float?
  organization        Organization   @relation(fields: [organizationId], references: [id])
  projects            Project[]

  @@unique([organizationId, customerId])
  @@index([leadId])
  @@index([status])
  @@index([createdAt])
  @@index([mobile])
  @@index([companyName])
  @@index([isDeleted])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Lead {
  id                  String              @id @default(uuid())
  customerName        String
  companyName         String
  mobile              String
  email               String
  city                String?
  projectTitle        String
  projectType         ProjectType
  projectCode         String?
  structureType       StructureType
  source              LeadSource
  priority            LeadPriority
  status              LeadStatus          @default(New)
  lastFollowUp        DateTime?
  nextFollowUpDate    DateTime?
  updatedAt           DateTime            @updatedAt
  remarks             String?
  createdAt           DateTime            @default(now())
  createdById         String
  isConverted         Boolean             @default(false)
  leadNumber          Int                 @default(autoincrement())
  deletedAt           DateTime?
  deletedById         String?
  isDeleted           Boolean             @default(false)
  alternateMobile     String?
  attachments         String[]
  baySpacing          Float?
  convertedDate       DateTime?
  craneCapacity       Float?
  craneRequired       Boolean             @default(false)
  createdBy           String?
  customFields        Json?
  customerId          String?
  customerNotes       String?
  gstNumber           String?
  height              Float?
  insulationRequired  Boolean             @default(false)
  insulationThickness Float?
  insulationType      String?
  length              Float?
  mapCoordinates      String?
  mezzanine           Boolean             @default(false)
  mezzanineArea       Float?
  mezzanineLoad       Float?
  pincode             String?
  score               Int?
  siteAddress         String?
  siteLocation        String?
  soilNotes           String?
  specialRequirement  String?
  state               String?
  updatedBy           String?
  width               Float?
  addressLine1        String?
  addressLine2        String?
  annualRevenue       Float?
  area                String?
  businessType        BusinessType?
  companyLogo         String?
  companySize         String?
  country             String?
  designation         String?
  employeeCount       Int?
  facebook            String?
  industry            Industry?
  instagram           String?
  linkedin            String?
  organizationId      String
  panNumber           String?
  profileImage        String?
  tags                String[]
  website             String?
  materialPreference  MaterialPreference?
  roofType            RoofType?
  wallType            WallType?
  assignedTo          String?
  assignedToId        String?
  currentDate         String?
  organization        Organization        @relation("OrganizationLeads", fields: [organizationId], references: [id])

  @@unique([organizationId, leadNumber])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([nextFollowUpDate])
  @@index([mobile])
  @@index([companyName])
  @@index([createdById])
  @@index([assignedToId])
  @@index([isDeleted])
  @@index([organizationId])
  @@index([organizationId, status])
}

model Project {
  id                      String              @id @default(uuid())
  organizationId          String
  projectId               Int                 @default(autoincrement())
  projectCode             String?
  projectName             String
  customerId              String
  customerName            String?
  leadId                  String?
  projectType             String
  value                   Float?
  budget                  Float?
  location                String
  city                    String
  state                   String
  pincode                 String?
  startDate               DateTime?
  endDate                 DateTime?
  priority                ProjectPriority
  projectManager          String?
  projectManagerId        String
  structureType           String
  width                   Float?
  length                  Float?
  height                  Float?
  baySpacing              Float?
  roofType                String
  craneSystem             String
  mezzanine               Boolean             @default(false)
  wallType                String
  insulation              Boolean             @default(false)
  coveredArea             Float?
  totalWeight             Float?
  status                  String              @default("New")
  stage                   ProjectStage?
  progress                Int                 @default(0)
  designProgress          Int                 @default(0)
  procurementProgress     Int                 @default(0)
  fabricationProgress     Int                 @default(0)
  installationProgress    Int                 @default(0)
  healthStatus            String              @default("Healthy")
  timelineHealth          String              @default("Healthy")
  budgetHealth            String              @default("Healthy")
  materialHealth          String              @default("Healthy")
  resourceHealth          String              @default("Healthy")
  materialCost            Float?
  procurementCost         Float?
  fabricationCost         Float?
  installationCost        Float?
  profitMargin            Float?
  boqId                   String?
  designId                String?
  estimateId              String?
  proposalId              String?
  quotationId             String?
  invoiceIds              String[]
  inventoryReservationIds String[]
  reservedItems           String[]
  consumedItems           String[]
  customFields            Json?
  createdById             String?
  createdBy               String?
  updatedBy               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  isDeleted               Boolean             @default(false)
  deletedAt               DateTime?
  deletedById             String?
  customer                Customer            @relation(fields: [customerId], references: [id])
  organization            Organization        @relation(fields: [organizationId], references: [id])
  activities              ProjectActivity[]
  milestones              ProjectMilestone[]
  tasks                   ProjectTask[]
  teamMembers             ProjectTeamMember[]

  @@unique([organizationId, projectId])
  @@index([status])
  @@index([stage])
  @@index([priority])
  @@index([createdAt])
  @@index([customerId])
  @@index([customerName])
  @@index([projectManagerId])
  @@index([isDeleted])
  @@index([projectCode])
  @@index([organizationId])
  @@index([organizationId, status])
}

model ProjectMilestone {
  id          String                 @id @default(uuid())
  projectId   String
  name        String
  plannedDate DateTime?
  actualDate  DateTime?
  status      ProjectMilestoneStatus @default(Pending)
  delay       Int?
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTeamMember {
  id           String   @id @default(uuid())
  projectId    String
  employeeId   String
  name         String?
  role         String
  assignedDate DateTime @default(now())
  workload     Int?
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([employeeId])
}

model ProjectActivity {
  id          String              @id @default(uuid())
  projectId   String
  type        ProjectActivityType
  description String
  performedBy String?
  performedAt DateTime            @default(now())
  metadata    Json?
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, performedAt])
}

model ProjectTask {
  id             String            @id @default(uuid())
  projectId      String
  title          String
  description    String?
  assignedTo     String
  assignedToName String?
  dueDate        DateTime?
  priority       ProjectPriority
  status         ProjectTaskStatus @default(Pending)
  dependencies   String[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, status])
  @@index([assignedTo])
}

model Task {
  id                String            @id @default(uuid())
  organizationId    String?
  title             String
  description       String?
  createdById       String?
  dueDate           DateTime?
  status            TaskStatus        @default(Pending)
  priority          TaskPriority      @default(Medium)
  category          TaskCategory      @default(General)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  deletedById       String?
  assignedTo        String?
  assignedUserId    String?
  assignedUserName  String?
  completedAt       DateTime?
  estimatedHours    Float?
  progress          Int?
  projectId         String?
  startDate         DateTime?
  taskId            String?
  timeSpent         Float?
  afterImages       String[]
  beforeImages      String[]
  completionNotes   String?
  completionProof   Json?
  createdByName     String?
  customerId        String?
  documentId        String?
  incentiveValue    Float             @default(0)
  leadId            String?
  notes             String?
  reminderDate      DateTime?
  tags              String[]
  verificationNotes String?
  verifiedAt        DateTime?
  verifiedBy        String?
  verifiedByName    String?
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  activityLogs      TaskActivityLog[]
  attachments       TaskAttachment[]
  checklists        TaskChecklist[]
  comments          TaskComment[]
  dependsOn         TaskDependency[]  @relation("DependentTasks")
  dependencies      TaskDependency[]  @relation("TaskDependencies")

  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedTo])
  @@index([organizationId])
  @@index([projectId])
  @@index([isDeleted])
}

model TaskChecklist {
  id          String    @id @default(uuid())
  taskId      String
  text        String
  completed   Boolean   @default(false)
  completedAt DateTime?
  completedBy String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskComment {
  id         String   @id @default(uuid())
  taskId     String
  content    String
  authorId   String
  authorName String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model TaskAttachment {
  id             String   @id @default(uuid())
  taskId         String
  fileName       String
  fileType       String
  fileSize       Int
  fileUrl        String
  uploadedBy     String
  uploadedByName String
  description    String?
  createdAt      DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  dependsOnTaskId String
  relationship    String   @default("Depends On")
  createdAt       DateTime @default(now())
  dependsOn       Task     @relation("DependentTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskActivityLog {
  id              String   @id @default(uuid())
  taskId          String
  activityType    String
  description     String
  performedBy     String
  performedByName String
  metadata        Json?
  createdAt       DateTime @default(now())
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

model SalaryAdjustment {
  id             String                 @id @default(uuid())
  organizationId String
  employeeId     String
  employeeName   String
  type           SalaryAdjustmentType
  amount         Float
  description    String
  reason         String?
  referenceType  String?
  referenceId    String?
  referenceName  String?
  status         SalaryAdjustmentStatus @default(Pending)
  approvedBy     String?
  approvedByName String?
  approvedAt     DateTime?
  processedAt    DateTime?
  processedBy    String?
  notes          String?
  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  isDeleted      Boolean                @default(false)
  organization   Organization           @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, employeeId])
  @@index([organizationId, status])
  @@index([employeeId])
  @@index([isDeleted])
}

model InventoryCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  code           String?
  isDeleted      Boolean      @default(false)
  parentId       String?
  sortOrder      Int?
