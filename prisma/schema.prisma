// Workflow models
model BusinessEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  eventType   String
  data        Json?
  triggeredBy String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
}

model EventRule {
  id             String   @id @default(uuid())
  organizationId String?
  entityType     String
  eventType      String
  fromStatus     String?
  toStatus       String
  conditions     Json?
  actions        Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([entityType, eventType])
  @@index([organizationId])
  @@index([isActive])
}

model StatusHistory {
  id             String   @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  fromStatus     String?
  toStatus       String
  changedBy      String?
  changedById    String?
  changedByName  String?
  reason         String?
  metadata       Json?
  changedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([toStatus])
  @@index([createdAt])
  @@index([changedAt])
}
