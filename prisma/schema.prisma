generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                   String               @id @default(uuid())
  name                 String
  slug                 String?              @unique
  code                 String?              @unique
  email                String?              @unique
  mobile               String?
  address              String?
  city                 String?
  state                String?
  country              String?              @default("India")
  pincode              String?
  gstNumber            String?
  panNumber            String?
  website              String?
  status               OrganizationStatus   @default(Active)
  maxUsers             Int                  @default(25)
  maxStorageGb         Int                  @default(10)
  subscriptionTier     String               @default("free")
  settings             Json?
  permissionPool       Json? // Pool of permissions delegated by Super Admin
  roleHierarchyEnabled Boolean              @default(true)
  maxRoleDepth         Int                  @default(5) // Maximum hierarchy depth
  createdById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  isDeleted            Boolean              @default(false)
  deletedAt            DateTime?
  deletedById          String?
  version              Int                  @default(1)
  customers            Customer[]
  inventoryCategories  InventoryCategory[]
  inventoryItems       InventoryItem[]
  itemBundles          ItemBundle[]
  itemMasters          ItemMaster[]
  itemVariants         ItemVariant[]
  leads                Lead[]
  projects             Project[]
  purchaseOrders       PurchaseOrder[]
  salaryAdjustments    SalaryAdjustment[]
  stockMovements       StockMovement[]
  suppliers            Supplier[]
  tasks                Task[]
  users                User[]
  vendors              Vendor[]
  warehouses           Warehouse[]
  roles                Role[]
  userRoles            UserRole[]
  modules              OrganizationModule[]

  @@index([status])
  @@index([email])
  @@index([name])
  @@index([slug])
  @@index([code])
  @@index([isDeleted])
  @@index([createdAt])
}

model User {
  id                        String           @id @default(uuid())
  email                     String           @unique
  password                  String
  isActive                  Boolean          @default(false)
  isVerified                Boolean          @default(false)
  otp                       String?
  otpExpiry                 DateTime?
  otpAttempts               Int              @default(0)
  role                      SystemRole       @default(EMPLOYEE)
  organizationType          OrganizationType @default(COMPANY)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  avatar                    String?
  department                String?
  designation               String?
  failedLoginAttempts       Int              @default(0)
  isLocked                  Boolean          @default(false)
  lastLogin                 DateTime?
  lockedUntil               DateTime?
  mobile                    String?
  name                      String?
  organizationId            String?
  passwordHistory           Json?
  passwordVersion           Int              @default(1)
  permissionVersion         Int              @default(1) // Track permission changes
  effectivePermissions      Json? // Cached effective permissions
  lastPermissionCalculation DateTime?
  version                   Int              @default(1)
  isDeleted                 Boolean          @default(false)
  deletedAt                 DateTime?
  deletedById               String?
  refreshTokens             RefreshToken[]
  sessions                  Session[]
  organization              Organization?    @relation(fields: [organizationId], references: [id])
  userRoles                 UserRole[]
  createdEntities           AuditLog[]       @relation("CreatedEntities")
  updatedEntities           AuditLog[]       @relation("UpdatedEntities")

  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@index([organizationId, role])
  @@index([isDeleted])
  @@index([isActive])
}

model Session {
  id             String         @id @default(uuid())
  userId         String
  organizationId String?
  token          String         @unique
  refreshToken   String?
  device         String?
  browser        String?
  os             String?
  ipAddress      String?
  userAgent      String?
  loginAt        DateTime       @default(now())
  lastActivity   DateTime       @default(now())
  expiresAt      DateTime
  idleExpiresAt  DateTime
  isRevoked      Boolean        @default(false)
  revokedAt      DateTime?
  isRememberMe   Boolean        @default(false)
  refreshTokens  RefreshToken[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([userId, isRevoked])
  @@index([expiresAt])
  @@index([organizationId])
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  sessionId           String
  userId              String
  organizationId      String?
  expiresAt           DateTime
  isRevoked           Boolean   @default(false)
  revokedAt           DateTime?
  replacedByTokenHash String?
  session             Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([sessionId])
  @@index([userId])
  @@index([organizationId])
}

model LoginAttempt {
  id             String    @id @default(uuid())
  email          String
  organizationId String?
  ipAddress      String?
  userAgent      String?
  success        Boolean
  failureReason  String?
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([email, createdAt])
  @@index([organizationId])
}

/// Hashed OTP challenges only — never plaintext OTP, never email HTML/text/subject.
/// Rows are hard-deleted immediately after successful verification, expiry, or invalidation.
model OtpChallenge {
  id          String     @id @default(uuid())
  email       String
  userId      String?
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int
  resendCount Int        @default(0)
  maxResends  Int
  /// Legacy soft-consume marker; runtime prefers hard-delete after use/expiry.
  consumedAt  DateTime?
  lastSentAt  DateTime   @default(now())
  /// Operational metadata only — never OTP, HTML, subject, or secrets.
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([email, purpose, consumedAt])
  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  sessionId      String?
  action         String
  resource       String?
  resourceId     String?
  resourceCode   String?
  before         Json?
  after          Json?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  correlationId  String?
  requestId      String?
  severity       AuditSeverity @default(INFO)
  createdAt      DateTime      @default(now())
  createdBy      User?         @relation("CreatedEntities", fields: [userId], references: [id], map: "AuditLog_createdBy_fkey")
  updatedBy      User?         @relation("UpdatedEntities", fields: [userId], references: [id], map: "AuditLog_updatedBy_fkey")

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([resourceId])
  @@index([createdAt])
  @@index([severity])
  @@index([correlationId])
  @@index([organizationId, createdAt])
}

model Role {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  code           String?
  description    String?
  permissions    String[] // Keep for backward compatibility
  permissionIds  String[] // New: explicit permission references
  inheritsFromId String? // Parent role for inheritance
  isSystem       Boolean   @default(false)
  level          Int       @default(0) // Hierarchy level
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedById    String?

  organization    Organization     @relation(fields: [organizationId], references: [id])
  inheritsFrom    Role?            @relation("RoleHierarchy", fields: [inheritsFromId], references: [id])
  inheritedRoles  Role[]           @relation("RoleHierarchy")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isDeleted])
  @@index([inheritsFromId])
}

model Permission {
  id             String   @id @default(uuid())
  organizationId String?
  key            String // e.g. "leads.view", "leads.create", "leads.update", "leads.delete"
  module         String // module key: "leads", "customers", "projects", ...
  action         String // "view", "create", "update", "delete", "export", "import", "approve", "manage"
  label          String
  description    String?
  category       String   @default("general")
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([organizationId, key])
  @@index([module])
  @@index([organizationId])
  @@index([action])
}

model UserRole {
  id             String   @id @default(uuid())
  userId         String
  roleId         String
  organizationId String
  assignedById   String?
  assignedAt     DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedById  String?
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model PermissionDelegation {
  id             String    @id @default(uuid())
  organizationId String
  delegatedBy    String // User ID who delegated
  delegatedTo    String // User ID receiving delegation
  permissionId   String
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedBy      String?
  reason         String?

  @@index([organizationId])
  @@index([delegatedBy])
  @@index([delegatedTo])
  @@index([permissionId])
}

model OrganizationModule {
  id             String    @id @default(uuid())
  organizationId String
  moduleKey      String
  enabled        Boolean   @default(true)
  configuredById String?
  enabledAt      DateTime?
  disabledAt     DateTime?
  settings       Json?
  grantedBy      String? // Super Admin who granted this module
  permissionSet  Json? // Specific permissions granted for this module
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleKey])
  @@index([organizationId])
  @@index([moduleKey])
}

model SystemSettings {
  id        String      @id @default(uuid())
  key       String      @unique
  value     Json
  type      SettingType @default(STRING)
  category  String      @default("general")
  isSecret  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([category])
}

