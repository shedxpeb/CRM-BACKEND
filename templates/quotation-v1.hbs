<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Commercial Proposal - {{meta.quotationNumber}}</title>
  <style>
    /* ─── Page Setup ─────────────────────────────────────────────────── */
    @page {
      size: A4 portrait;
      margin: 0;
    }

    @page :first {
      margin: 0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Calibri', 'Segoe UI', Arial, Helvetica, sans-serif;
      font-size: 10pt;
      line-height: 1.4;
      color: #1a1a1a;
      background: white;
    }

    @media print {
      body {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }

    /* ─── Color Variables ────────────────────────────────────────────── */
    :root {
      --primary: {{branding.primaryColor}};
      --secondary: {{branding.secondaryColor}};
      --text-dark: #1a1a1a;
      --text-muted: #5b6778;
      --border: #d1d5db;
      --bg-light: #f8fafc;
      --bg-accent: #e8f0fe;
    }

    body {
      --primary: {{branding.primaryColor}};
      --secondary: {{branding.secondaryColor}};
      --text-dark: #1a1a1a;
      --text-muted: #5b6778;
      --border: #d1d5db;
      --bg-light: #f8fafc;
      --bg-accent: #e8f0fe;
    }

    /* ─── Cover Page (Image-Based) ───────────────────────────────────────── */
    .cover-page {
      width: 210mm;
      height: 297mm;
      position: relative;
      overflow: hidden;
      page-break-after: always;
      margin: 0;
      padding: 0;
    }

    .cover-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    /* ─── Page Container ─────────────────────────────────────────────── */
    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 15mm 18mm 22mm 18mm;
      position: relative;
      page-break-after: always;
      page-break-inside: avoid;
      background: white;
    }

    .page:last-child {
      page-break-after: auto;
    }

    /* ─── Watermark (pages 2+) ───────────────────────────────────────── */
    {{#if branding.watermarkImage}}
    .page::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background-image: url('{{branding.watermarkImage}}');
      background-repeat: no-repeat;
      background-position: center;
      background-size: 120mm 120mm;
      opacity: 0.03;
      z-index: 0;
      pointer-events: none;
    }
    .page > * {
      position: relative;
      z-index: 1;
    }
    {{/if}}

    /* ─── Page 3 Table Styling ─────────────────────────────────────────── */
    .page3-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid black;
      font-size: 8pt;
    }

    .page3-table th,
    .page3-table td {
      border: 1px solid black;
      padding: 3px 6px;
      text-align: left;
      vertical-align: top;
    }

    .page3-header-yellow {
      background-color: #fffacd;
      font-weight: bold;
      text-align: center;
      font-size: 9pt;
      padding: 4px;
    }

    .page3-header-gray {
      background-color: #e0e0e0;
      font-weight: bold;
      text-align: center;
      font-size: 9pt;
      padding: 4px;
    }

    .page3-col-no {
      width: 30px;
      text-align: center;
      font-weight: bold;
    }

    .page3-col-field {
      width: 140px;
      font-weight: bold;
    }

    .page3-col-sep {
      width: 15px;
      text-align: center;
    }

    .page3-col-value {
      text-align: left;
      white-space: pre-wrap;
    }

    /* ─── Page 4 Accessories Table Styling ───────────────────────────────── */
    .page4-accessories-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid black;
      font-size: 8pt;
    }

    .page4-accessories-table th,
    .page4-accessories-table td {
      border: 1px solid black;
      padding: 3px 6px;
      text-align: left;
      vertical-align: top;
    }

    .page4-col-no {
      width: 25px;
      text-align: center;
      font-weight: bold;
    }

    .page4-col-desc {
      width: 35%;
      white-space: pre-wrap;
    }

    .page4-col-size {
      width: 20%;
    }

    .page4-col-qty {
      width: 20%;
    }

    .page4-col-loc {
      width: 25%;
    }

    /* ─── Page 6 Material Table Styling ───────────────────────────────── */
    .page6-material-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid black;
      font-size: 8pt;
    }

    .page6-material-table th,
    .page6-material-table td {
      border: 1px solid black;
      padding: 4px 6px;
      text-align: left;
      vertical-align: top;
    }

    .page6-col-sno {
      width: 40px;
      text-align: center;
      font-weight: bold;
    }

    .page6-col-comp {
      width: 25%;
      white-space: pre-wrap;
    }

    .page6-col-spec {
      width: 35%;
      white-space: pre-wrap;
    }

    .page6-col-make {
      width: 20%;
    }

    .page6-col-yield {
      width: 20%;
    }

    /* ─── Page 7 Price Table Styling ───────────────────────────────── */
    .page7-price-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid black;
      font-size: 8pt;
    }

    .page7-price-table th,
    .page7-price-table td {
      border: 1px solid black;
      padding: 4px 6px;
      text-align: left;
      vertical-align: top;
    }

    .page7-col-sno {
      width: 40px;
      text-align: center;
      font-weight: bold;
    }

    .page7-col-desc {
      width: 40%;
      white-space: pre-wrap;
    }

    .page7-col-unit {
      width: 12%;
    }

    .page7-col-qty {
      width: 10%;
      text-align: center;
    }

    .page7-col-rate {
      width: 14%;
      text-align: right;
    }

    .page7-col-amount {
      width: 14%;
      text-align: right;
    }

    .page7-total-label {
      text-align: right;
      font-weight: bold;
      padding-right: 10px;
    }

    .page7-total-value {
      text-align: right;
      font-weight: bold;
    }

    .page7-grand-label {
      text-align: right;
      font-weight: bold;
      padding-right: 10px;
      background-color: #f0f0f0;
    }

    .page7-grand-value {
      text-align: right;
      font-weight: bold;
      background-color: #f0f0f0;
    }

    /* ─── Header (pages 2+) ─────────────────────────────────────────── */
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 8px;
      border-bottom: 2px solid var(--primary);
      margin-bottom: 16px;
    }

    .page-header-logo {
      max-height: 28px;
    }

    .page-header-title {
      font-size: 8pt;
      color: var(--text-muted);
      text-align: right;
    }

    .page-header-title strong {
      color: var(--primary);
      display: block;
      font-size: 9pt;
    }

    /* ─── Footer (all pages) ─────────────────────────────────────────── */
    .page-footer {
      position: absolute;
      bottom: 12mm;
      left: 18mm;
      right: 18mm;
      border-top: 1px solid var(--primary);
      padding-top: 6px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 7pt;
      color: var(--text-muted);
    }

    .page-footer .company-name {
      font-weight: 600;
      color: var(--primary);
    }

    /* ─── Section Headings ───────────────────────────────────────────── */
    .section-title {
      font-size: 13pt;
      font-weight: 700;
      color: var(--primary);
      margin: 20px 0 10px 0;
      padding-bottom: 6px;
      border-bottom: 2px solid var(--primary);
    }

    .section-title:first-child {
      margin-top: 0;
    }

    .subsection-title {
      font-size: 10.5pt;
      font-weight: 700;
      color: var(--secondary);
      margin: 14px 0 6px 0;
    }

    /* ─── Info Tables ────────────────────────────────────────────────── */
    .info-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
    }

    .info-table th {
      background: var(--primary);
      color: white;
      font-size: 8pt;
      font-weight: 600;
      padding: 5px 8px;
      text-align: left;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .info-table td {
      padding: 5px 8px;
      border-bottom: 1px solid var(--border);
      font-size: 9pt;
      vertical-align: top;
    }

    .info-table tr:nth-child(even) td {
      background: var(--bg-light);
    }

    .info-table .label {
      font-weight: 600;
      color: var(--text-muted);
      width: 40%;
    }

    /* ─── Two Column Layout ──────────────────────────────────────────── */
    .two-col {
      display: flex;
      gap: 16px;
      margin-bottom: 12px;
    }

    .two-col .col {
      flex: 1;
    }

    .col-header {
      background: var(--primary);
      color: white;
      font-weight: 600;
      font-size: 9pt;
      padding: 5px 10px;
      margin-bottom: 0;
    }

    .col-body {
      border: 1px solid var(--border);
      border-top: none;
      padding: 8px 10px;
      min-height: 80px;
      background: var(--bg-light);
    }

    .col-body .field {
      margin-bottom: 5px;
    }

    .col-body .field-label {
      font-size: 7.5pt;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .col-body .field-value {
      font-size: 9pt;
      color: var(--text-dark);
      border-bottom: 1px solid #e5e7eb;
      padding: 2px 0;
    }

    /* ─── Spec Grid ──────────────────────────────────────────────────── */
    .spec-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 20px;
      margin-bottom: 12px;
    }

    .spec-item {
      display: flex;
      justify-content: space-between;
      padding: 4px 0;
      border-bottom: 1px dotted var(--border);
      font-size: 9pt;
    }

    .spec-item .spec-label {
      font-weight: 600;
      color: var(--text-muted);
    }

    .spec-item .spec-value {
      color: var(--text-dark);
      font-weight: 500;
    }

    /* ─── Data Table ─────────────────────────────────────────────────── */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      font-size: 8.5pt;
    }

    .data-table thead th {
      background: var(--primary);
      color: white;
      font-weight: 600;
      padding: 6px 6px;
      text-align: left;
      font-size: 7.5pt;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .data-table thead th.right {
      text-align: right;
    }

    .data-table thead th.center {
      text-align: center;
    }

    .data-table tbody td {
      padding: 5px 6px;
      border-bottom: 1px solid #e5e7eb;
      vertical-align: top;
    }

    .data-table tbody td.right {
      text-align: right;
    }

    .data-table tbody td.center {
      text-align: center;
    }

    .data-table tbody tr:nth-child(even) td {
      background: var(--bg-light);
    }

    .data-table tbody tr:hover td {
      background: #eef2ff;
    }

    /* ─── Summary Panel ──────────────────────────────────────────────── */
    .summary-panel {
      width: 320px;
      margin-left: auto;
      border: 1px solid var(--border);
      margin-bottom: 12px;
    }

    .summary-panel .summary-header {
      background: var(--primary);
      color: white;
      font-weight: 700;
      font-size: 9pt;
      padding: 6px 10px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 4px 10px;
      border-bottom: 1px solid #f0f0f0;
      font-size: 9pt;
    }

    .summary-row .summary-label {
      color: var(--text-muted);
    }

    .summary-row .summary-value {
      font-weight: 500;
      color: var(--text-dark);
    }

    .summary-grand-total {
      display: flex;
      justify-content: space-between;
      background: var(--primary);
      color: white;
      padding: 8px 10px;
      font-weight: 700;
      font-size: 10pt;
    }

    .amount-words {
      margin-top: 8px;
      padding: 8px 10px;
      background: var(--bg-light);
      border: 1px solid var(--border);
      font-size: 8.5pt;
    }

    .amount-words .label {
      font-weight: 700;
      color: var(--text-muted);
      font-size: 7.5pt;
      text-transform: uppercase;
      display: block;
      margin-bottom: 3px;
    }

    .amount-words .value {
      font-style: italic;
      color: var(--text-dark);
    }

    /* ─── Lists ──────────────────────────────────────────────────────── */
    .content-list {
      list-style: none;
      padding: 0;
      margin-bottom: 12px;
    }

    .content-list li {
      padding: 3px 0 3px 16px;
      position: relative;
      font-size: 9pt;
      line-height: 1.5;
    }

    .content-list li::before {
      content: '•';
      position: absolute;
      left: 0;
      color: var(--primary);
      font-weight: bold;
    }

    /* ─── Terms Box ──────────────────────────────────────────────────── */
    .terms-box {
      background: var(--bg-light);
      border: 1px solid var(--border);
      padding: 10px 12px;
      margin-bottom: 12px;
      font-size: 8.5pt;
      line-height: 1.6;
      white-space: pre-wrap;
    }

    /* ─── Notes Box ──────────────────────────────────────────────────── */
    .notes-box {
      background: #fef3c7;
      border: 1px solid #f59e0b;
      padding: 10px 12px;
      margin-bottom: 12px;
      font-size: 8.5pt;
    }

    .notes-box .notes-title {
      font-weight: 700;
      color: #92400e;
      margin-bottom: 4px;
    }

    /* ─── Signature Block ────────────────────────────────────────────── */
    .signature-block {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .signature-box {
      width: 45%;
      text-align: center;
    }

    .signature-box .sig-line {
      border-top: 1px solid var(--text-dark);
      margin: 40px 0 6px 0;
    }

    .signature-box .sig-label {
      font-size: 8pt;
      color: var(--text-muted);
    }

    .signature-box .sig-name {
      font-size: 9pt;
      font-weight: 600;
      color: var(--text-dark);
    }

    /* ─── Info Cards ─────────────────────────────────────────────────── */
    .info-card {
      background: var(--bg-light);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 10px 12px;
      margin-bottom: 10px;
    }

    .info-card .card-title {
      font-weight: 700;
      color: var(--primary);
      font-size: 9.5pt;
      margin-bottom: 6px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 4px;
    }

    /* ─── Milestone Table ────────────────────────────────────────────── */
    .milestone-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 8.5pt;
    }

    .milestone-table th {
      background: var(--secondary);
      color: white;
      padding: 4px 8px;
      text-align: left;
      font-size: 7.5pt;
    }

    .milestone-table td {
      padding: 4px 8px;
      border-bottom: 1px solid var(--border);
    }

    /* ─── Keep Together ──────────────────────────────────────────────── */
    .keep-together {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .avoid-orphans {
      orphans: 3;
      widows: 3;
    }
  </style>
</head>
<body>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- PAGE 1: SHEDX PEB COMMERCIAL PROPOSAL COVER PAGE (IMAGE-BASED)       -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="cover-page">
    <img src="{{coverImageData}}" class="cover-image" alt="Commercial Proposal Cover">
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- PAGE 2: PREPARED FOR / PREPARED BY / DATE / INQUIRY / SUBJECT / INTRODUCTION / SIGNATURE -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="page">
    <div class="page-header">
      {{#if organization.logo}}<img src="{{organization.logo}}" class="page-header-logo" alt="Logo">{{/if}}
      <div class="page-header-title">
        <strong>Inq. No. {{meta.inquiryNumber}}</strong>
        Commercial Proposal
      </div>
    </div>

    <div style="margin-bottom: 20px;">
      <div style="display: inline-block; margin-right: 30px;">
        <strong>DATE:</strong> {{meta.quotationDate}}
      </div>
    </div>

    <div class="two-col" style="margin-bottom: 20px;">
      <div class="col">
        <div class="col-header" style="background: var(--primary); color: white;">Prepared For</div>
        <div class="col-body">
          <div class="field">
            <div class="field-label">COMPANY</div>
            <div class="field-value">{{preparedFor.companyName}}</div>
          </div>
          <div class="field">
            <div class="field-label">ADD</div>
            <div class="field-value">{{preparedFor.address}}{{#if preparedFor.city}}, {{preparedFor.city}}{{/if}}{{#if preparedFor.state}}, {{preparedFor.state}}{{/if}}{{#if preparedFor.pincode}} - {{preparedFor.pincode}}{{/if}}</div>
          </div>
          {{#if preparedFor.gstNumber}}
          <div class="field">
            <div class="field-label">GST</div>
            <div class="field-value">{{preparedFor.gstNumber}}</div>
          </div>
          {{/if}}
        </div>
      </div>
      <div class="col">
        <div class="col-header" style="background: var(--primary); color: white;">Prepared By</div>
        <div class="col-body">
          <div class="field">
            <div class="field-value"><strong>{{preparedBy.company}}</strong></div>
          </div>
          <div class="field">
            <div class="field-value">{{preparedBy.address}}</div>
          </div>
          {{#if preparedBy.gstin}}
          <div class="field">
            <div class="field-label">GSTIN</div>
            <div class="field-value">{{preparedBy.gstin}}</div>
          </div>
          {{/if}}
        </div>
      </div>
    </div>

    <div class="section-title">Subject</div>
    <p style="font-size:9pt; margin-bottom:14px; line-height:1.6;">{{subject}}</p>

    <div class="section-title">Introduction</div>
    <p style="font-size:9pt; margin-bottom:14px; line-height:1.6; white-space: pre-wrap;" class="avoid-orphans">
      {{introduction}}
    </p>

    <div style="margin-top: 30px;">
      <p style="font-size:9pt; margin-bottom: 10px;">{{signature.prefix}}</p>
      <p style="font-size:9pt; font-weight: bold; margin-bottom: 5px;">{{signature.name}}</p>
      <p style="font-size:9pt; margin-bottom: 5px;">{{signature.designation}}</p>
      {{#if signature.mobile}}
      <p style="font-size:9pt; margin-bottom: 5px;">Mo.: {{signature.mobile}}</p>
      {{/if}}
      {{#if signature.email}}
      <p style="font-size:9pt;">Email: {{signature.email}}</p>
      {{/if}}
    </div>

    <div class="page-footer">
      <span class="company-name">{{organization.name}}</span>
      <span>Page 2 of 10</span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- PAGE 3: BUILDING SPECIFICATION / DESIGN CODE / DESIGN LOAD        -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="page">
    <div class="page-header">
      {{#if organization.logo}}<img src="{{organization.logo}}" class="page-header-logo" alt="Logo">{{/if}}
      <div class="page-header-title">
        <strong>Inq. No. {{meta.inquiryNumber}}</strong>
      </div>
    </div>

    <!-- BUILDING SPECIFICATION TABLE -->
    <table class="page3-table" style="margin-bottom: 12px;">
      <thead>
        <tr>
          <th colspan="4" class="page3-header-yellow">BUILDING SPECIFICATION</th>
        </tr>
        <tr>
          <th class="page3-col-no">No.</th>
          <th class="page3-col-field">Field</th>
          <th class="page3-col-sep">:</th>
          <th class="page3-col-value">Value</th>
        </tr>
      </thead>
      <tbody>
        <tr><td class="page3-col-no">1</td><td>FRAME TYPE</td><td class="page3-col-sep">:</td><td>{{building.frameType}}</td></tr>
        <tr><td class="page3-col-no">2</td><td>END FRAME CONDITION</td><td class="page3-col-sep">:</td><td>{{building.endFrameCondition}}</td></tr>
        <tr><td class="page3-col-no">3</td><td>WIDTH</td><td class="page3-col-sep">:</td><td>{{building.width}}</td></tr>
        <tr><td class="page3-col-no">4</td><td>LENGTH</td><td class="page3-col-sep">:</td><td>{{building.length}}</td></tr>
        <tr><td class="page3-col-no">5</td><td>CLEAR HEIGHT</td><td class="page3-col-sep">:</td><td>{{building.height}}</td></tr>
        <tr><td class="page3-col-no">6</td><td>WIDTH MODULE</td><td class="page3-col-sep">:</td><td>{{building.widthModule}}</td></tr>
        <tr><td class="page3-col-no">7</td><td>ROOF SLOPE</td><td class="page3-col-sep">:</td><td>{{building.roofSlope}}</td></tr>
        <tr><td class="page3-col-no">8</td><td>OPENING</td><td class="page3-col-sep">:</td><td>{{building.opening}}</td></tr>
        <tr><td class="page3-col-no">9</td><td>SIDEWALL BAY SPACING</td><td class="page3-col-sep">:</td><td>{{building.baySpacing}}</td></tr>
        <tr><td class="page3-col-no">10</td><td>ENDWALL BAY SPACING</td><td class="page3-col-sep">:</td><td>{{building.endwallBaySpacing}}</td></tr>
        <tr><td class="page3-col-no">11</td><td>BRICKWALL CONDITION</td><td class="page3-col-sep">:</td><td>{{building.brickwallCondition}}</td></tr>
        <tr><td class="page3-col-no">12</td><td>CANOPY</td><td class="page3-col-sep">:</td><td>{{building.canopy}}</td></tr>
